# KB Publicera MCP-server — konfigurationsmall
# Kopiera till .env och fyll i dina värden

# -----------------------------------------------------------------------
# Databas
# -----------------------------------------------------------------------

# PostgreSQL-anslutningssträng (inkl. lösenord om PostgreSQL kräver det)
# Standard: PostgreSQL i det gemensamma riksdagstryck-databasen
DATABASE_URL=postgresql://mitt_db_anvandare:LÖSENORD@127.0.0.1:5432/riksdagstryck

# Alternativ: SQLite-fil (för enklare installation utan PostgreSQL)
# Avkommentera raden nedan och kommentera bort PostgreSQL-raden ovan
# DATABASE_URL=sqlite:///publicera_kb_cache.db

# -----------------------------------------------------------------------
# DDK-filter
# -----------------------------------------------------------------------
# Kommaseparerad lista med DDK-avdelningskoder (XX0-nivå).
# Lämna tom för att indexera alla 53 tidskrifter utan begränsning.
#
# Avdelningarna nedan täcker:
#   020  Biblioteks- & informationsvetenskap (digitalisering, informationssökning)
#   210  Religionsfilosofi & religionsteori (historisk och filosofisk kontext)
#   300  Samhällsvetenskaper, sociologi & antropologi
#   310  Statistik
#   320  Statsvetenskap
#   330  Nationalekonomi
#   340  Juridik
#   350  Offentlig förvaltning & militärvetenskap
#   360  Sociala problem & sociala tjänster
#   370  Utbildning
#   380  Handel, kommunikationer & transport
#   390  Seder, etikett & folklore
#   430  Tyska & besläktade språk  (inkl. svenska — täcker dialekter och folkliv)
#   900  Historia
#   910  Geografi & resor
#   920  Biografi & genealogi
#   930  Forntida världens historia (före ca 499)
#   940  Europas historia
#   950  Asiens historia
#   960  Afrikas historia
#   970  Nordamerikas historia
#   980  Sydamerikas historia
#   990  Övriga områdens historia

PUBLICERA_DDK_FILTER=020,210,300,310,320,330,340,350,360,370,380,390,430,900,910,920,930,940,950,960,970,980,990

# -----------------------------------------------------------------------
# Query-expansion — flerspråkig begreppsexpansion (valfritt)
# -----------------------------------------------------------------------
# Aktivera AI-stödd begreppsexpansion. När aktiverad expanderar servern
# söktermen med ekvivalenter på svenska, engelska, franska, tyska,
# bokmål, nynorsk och danska innan sökningen körs.
#
# Stöder alla OpenAI-kompatibla endpoints:
#   Claude:    QUERY_EXPANSION_BASE_URL=https://api.anthropic.com/v1
#              QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001
#   OpenAI:    QUERY_EXPANSION_BASE_URL=https://api.openai.com/v1
#              QUERY_EXPANSION_MODEL=gpt-4o-mini
#   Ollama:    QUERY_EXPANSION_BASE_URL=http://localhost:11434/v1
#              QUERY_EXPANSION_MODEL=llama3.2
#   LM Studio: QUERY_EXPANSION_BASE_URL=http://localhost:1234/v1
#              QUERY_EXPANSION_MODEL=lmstudio-community/Meta-Llama-3.1-8B

QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_BASE_URL=https://api.anthropic.com/v1
QUERY_EXPANSION_API_KEY=din-api-nyckel-här
QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001

# Valfritt: anpassad promptfil (standard: prompts/expansion_prompt.txt)
# QUERY_EXPANSION_PROMPT_FILE=/abs/path/to/custom_prompt.txt

# -----------------------------------------------------------------------
# OAI-PMH (valfritt)
# -----------------------------------------------------------------------

# Tidsgräns i sekunder för HTTP-anrop mot KB Publicera
PUBLICERA_TIMEOUT=30

# Paus i sekunder mellan OAI-PMH-anrop (respektera KB:s servrar)
PUBLICERA_PAUS_SEKUNDER=0.5

# -----------------------------------------------------------------------
# Schemaläggning (används av: python3 02_synka_metadata.py --installera-schema)
# -----------------------------------------------------------------------

# Schemaläggare: launchd (macOS, rekommenderas) eller cron (Linux/macOS)
SCHEMALAGGARE=launchd

# Körtid i cron-format (standard: 03:30 varje natt)
CRON_SCHEMA=30 3 * * *

# Absolut eller relativ sökväg till Python-tolken
# Relativ sökväg räknas från skriptmappen (publicera-kb/)
# Standard: den gemensamma venv i MCP-Servers
PYTHON_SOKVAG=../.venv/bin/python3
